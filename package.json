{
  "name": "unsocial",
  "version": "1.0.16",
  "description": "A lightweight React component that detects when users are viewing your site in social media apps",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2u841r/unsocial.git"
  },
  "bugs": {
    "url": "https://github.com/2u841r/unsocial/issues"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "publish": "npm version patch && npm publish --otp=YOUR_CODE"
  },
  "keywords": [
    "unsocial",
    "browser-detection",
    "react",
    "social-media",
    "facebook",
    "instagram",
    "in-app-browser",
    "typescript"
  ],
  "author": "Zubair Ibn Zamir",
  "license": "MIT",
  "packageManager": "pnpm@10.14.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.2.4",
    "typescript": "^5.0.0"
  }
}
